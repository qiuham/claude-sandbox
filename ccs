#!/usr/bin/env python3
"""ccs（claude-sandbox）薄启动器。

用仓库自带的 .venv 跑：系统 python 里没有 invisible_playwright。
然后交给包入口 `python -m ccs`。
"""
import os
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
_VENV_DIR = _HERE / ".venv"
_VENV_PY = _VENV_DIR / "bin" / "python3"
_SRC = str(_HERE / "src")

# 比较 sys.prefix，不要比较 resolve() 后的解释器路径：venv 里的 python3 是指向
# 系统解释器的软链，resolve() 之后两边一样，判断会失效。
if _VENV_PY.is_file() and Path(sys.prefix).resolve() != _VENV_DIR.resolve():
    env = dict(os.environ)
    old = env.get("PYTHONPATH")
    env["PYTHONPATH"] = _SRC if not old else _SRC + os.pathsep + old
    os.execve(str(_VENV_PY), [str(_VENV_PY), "-m", "ccs", *sys.argv[1:]], env)  # noqa: S606 - 用 execve 替换当前进程，不经过 shell

sys.path.insert(0, _SRC)
from ccs.cli import main  # noqa: E402 - 先按上面的顺序处理 venv

raise SystemExit(main())
