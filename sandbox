#!/usr/bin/env python3
"""claude-sandbox —— 手工/自动两用的注册沙盒。

设计
----
一个沙盒 = 一个 profile（cookie/存储）+ 一个固定指纹种子 + 一个出口。

**出口不写死在哪台机器上。** 出口是一个 spec，可以是：

* 一个名字 —— 在配置里定义（见下）；
* 一个代理地址 —— `socks5h://host:port` 或 `http://host:port`。

配置里的出口有两种形态：

* `{"proxy": "socks5h://..."}` —— 显式指定一个代理；
* `{"direct": true}` —— 完全不用代理，走原生环境（出口由本机的 TUN/透明代理决定）。

配置文件：`~/.config/claude-sandbox/config.json`（`SANDBOX_CONFIG` 可改路径）。
没写配置时用内置默认：本机 Clash 7897 + 46.2 的 cox/wave/att。

命令
----
    sandbox new <名字> --exit cox            建沙盒（出口可以是名字或 socks5h:// 地址）
    sandbox open <名字>                      开窗口，手工注册
    sandbox check <名字>                     无头自检（需要 xvfb）
    sandbox list                             列出沙盒
    sandbox doctor                           检查依赖和出口配置
"""
from __future__ import annotations

import argparse
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

# 用仓库自带的 venv 跑：系统 python 里没有 invisible_playwright。
_VENV_DIR = Path(__file__).resolve().parent / ".venv"
_VENV_PY = _VENV_DIR / "bin" / "python3"
# 比较 sys.prefix，不要比较 resolve() 后的解释器路径：venv 里的 python3 是指向
# 系统解释器的软链，resolve() 之后两边一样，判断会失效。
if _VENV_PY.is_file() and Path(sys.prefix).resolve() != _VENV_DIR.resolve():
    os.execv(str(_VENV_PY), [str(_VENV_PY), str(Path(__file__).resolve()), *sys.argv[1:]])

CONFIG_FILE = Path(os.path.expanduser(
    os.environ.get("SANDBOX_CONFIG", "~/.config/claude-sandbox/config.json")))
ROOT = Path(os.path.expanduser(os.environ.get("SANDBOX_ROOT", "~/sandboxes"))).resolve()

DEFAULT_CONFIG = {}   # 没配置 = direct；配了 exit 就走它

NO_DIALOG_PREFS = {
    "browser.sessionstore.resume_from_crash": False,
    "browser.sessionstore.max_resumed_crashes": 0,
    "browser.startup.page": 0,
    "browser.shell.checkDefaultBrowser": False,
    "browser.aboutwelcome.enabled": False,
    "datareporting.policy.dataSubmissionEnabled": False,
    "toolkit.telemetry.enabled": False,
    "browser.tabs.warnOnClose": False,
    "dom.disable_beforeunload": True,
}

WEBRTC_JS = """
new Promise((res) => {
  const out = [];
  const pc = new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'}]});
  pc.createDataChannel('x');
  pc.onicecandidate = (e) => {
    if (!e.candidate) { res(out); return; }
    const m = e.candidate.candidate.match(/([0-9]{1,3}\\.){3}[0-9]{1,3}|[0-9a-f]{1,4}(:[0-9a-f]{0,4}){2,}/i);
    if (m) out.push(m[0]);
  };
  pc.createOffer().then(o => pc.setLocalDescription(o)).catch(() => res(out));
  setTimeout(() => res(out), 8000);
});
"""


def die(msg: str) -> None:
    print(f"错误: {msg}", file=sys.stderr)
    raise SystemExit(1)


def say(msg: str = "") -> None:
    print(msg, flush=True)


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if CONFIG_FILE.is_file():
        try:
            user = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            die(f"配置文件读不了: {CONFIG_FILE}: {exc}")
        value = str(user.get("exit") or user.get("exit") or "").strip()
        if value:
            cfg["exit"] = value
    return cfg


def sandbox_dir(name: str) -> Path:
    return ROOT / name


def meta_file(name: str) -> Path:
    return sandbox_dir(name) / "meta.json"


def read_meta(name: str) -> dict:
    f = meta_file(name)
    if not f.is_file():
        die(f"没有这个沙盒: {name}（先 sandbox new {name} --exit <出口>）")
    return json.loads(f.read_text(encoding="utf-8"))


def write_meta(name: str, meta: dict) -> None:
    meta_file(name).write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n",
                               encoding="utf-8")


def is_proxy_spec(spec: str) -> bool:
    return str(spec).startswith(("socks5://", "socks5h://", "http://", "https://"))


def resolve_exit(spec: str, cfg: dict) -> tuple[str, str]:
    """出口 spec → (规范化后的 spec, 代理地址)。地址为空串表示 direct。

    规则：没指定就用配置里的 default_exit；再没有就是 direct。
    """
    spec = str(spec or "").strip()
    if not spec:
        spec = str(cfg.get("exit") or "direct").strip() or "direct"
    if spec == "direct":
        return "direct", ""
    if is_proxy_spec(spec):
        return spec, spec
    die(f"出口只认 direct 或代理地址（socks5h://、http://），收到 {spec!r}")


def curl_exit(proxy: str) -> str:
    """用 curl 量出口 IP。proxy 为空 = 不指定代理，量的是这台机器原生出口。"""
    cmd = ["curl", "-s", "--max-time", "15"]
    if proxy:
        cmd += ["-x", proxy]
    cmd.append("https://api.ipify.org")
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=25)
        return out.stdout.strip() or f"(失败: {out.stderr.strip()[:80]})"
    except (OSError, subprocess.TimeoutExpired) as exc:
        return f"(失败: {exc})"


def preflight(name: str, spec: str, label: str, proxy: str) -> str:
    if proxy:
        say(f"出口    : {spec}")
    else:
        say(f"出口    : direct（不设代理，走原生环境）")
        say("         出口 IP 由这台机器的 TUN/透明代理决定；沙盒不替你设代理")
    ip = curl_exit(proxy)
    say(f"出口 IP : {ip}")
    if not ip.startswith("("):
        meta = read_meta(name)
        known = meta.get("exit_ip")
        if known and known != ip:
            say(f"注意    : 出口 IP 变了（上次 {known}，现在 {ip}）—— 同一个号跨会话换 IP 是风险信号")
        elif not known:
            meta["exit_ip"] = ip
            write_meta(name, meta)
    return ip


def seed_of(profile: Path) -> int:
    f = profile / "seed.json"
    if f.is_file():
        try:
            seed = json.loads(f.read_text(encoding="utf-8")).get("seed")
            if isinstance(seed, int):
                return seed
        except (OSError, json.JSONDecodeError):
            pass
    import random
    seed = random.SystemRandom().randrange(1, 2**31)
    f.write_text(json.dumps({"seed": seed}), encoding="utf-8")
    say(f"指纹种子: {seed}（写入 {f.name}，这个沙盒以后一直用它）")
    return seed


def launch(name: str, proxy: str, headless: bool, timeout: int = 0) -> int:
    try:
        from invisible_playwright import InvisiblePlaywright
    except ImportError:
        die("没装 invisible_playwright：在本仓库目录执行 .venv/bin/pip install -r requirements.txt")

    profile = sandbox_dir(name) / "profile"
    profile.mkdir(parents=True, exist_ok=True)
    kw = dict(
        seed=seed_of(profile),
        headless=headless,
        humanize=True,
        locale="auto",              # 按出口 IP 的地区选语言
        profile_dir=str(profile),
        extra_prefs=dict(NO_DIALOG_PREFS),
    )
    if proxy:
        kw["proxy"] = {"server": proxy.replace("socks5h://", "socks5://")}
    with InvisiblePlaywright(**kw) as browser:
        ctx = browser.contexts[0] if hasattr(browser, "contexts") and browser.contexts else browser
        page = ctx.new_page()
        page.set_default_timeout(45000)
        trace = page.goto("https://api.ipify.org", timeout=90000)
        say(f"页面加载完成（HTTP {trace.status if trace else '?'}）")
        if headless:
            say(f"页面出口 IP : {page.inner_text('body').strip()}")
            try:
                page.goto("https://www.cloudflare.com/", timeout=60000)
                say(f"WebRTC 候选 : {json.dumps(page.evaluate(WEBRTC_JS))}")
            except Exception as exc:      # noqa: BLE001 - 自检失败不该中断
                say(f"WebRTC 检测失败: {exc}")
            return 0
        # 手工模式：停在这里等用户用完；关掉窗口后退出
        page.goto("https://claude.ai/", timeout=90000)
        say("")
        say("浏览器已打开。手工注册/养号完成后，直接关掉浏览器窗口即可退出。")
        deadline = time.time() + timeout if timeout else 0
        while True:
            if deadline and time.time() > deadline:
                say("到达 --timeout，关闭浏览器")
                return 0
            try:
                page.wait_for_timeout(1000)
            except Exception:             # noqa: BLE001 - 用户关窗口
                say("窗口已关闭，沙盒数据已保留")
                return 0


def pick_exit(args, meta: dict | None = None) -> str:
    """命令行优先，其次沙盒记录；都没有就空串（resolve_exit 会兜底成配置/direct）。"""
    for value in (getattr(args, "proxy", None), getattr(args, "exit", None)):
        if value:
            return value
    spec = str((meta or {}).get("exit") or "")
    # 旧版本存过名字（cox 之类），现在只认 direct/地址；失效就当没记录。
    if spec and spec != "direct" and not is_proxy_spec(spec):
        say(f"注意    : 沙盒记录的出口 {spec!r} 已失效，改用默认出口")
        return ""
    return spec


def cmd_new(args) -> int:
    if args.name in {".", ".."} or "/" in args.name or "\\" in args.name:
        die("沙盒名字不能带路径分隔符")
    cfg = load_config()
    spec, _proxy = resolve_exit(pick_exit(args), cfg)
    d = sandbox_dir(args.name)
    if d.exists():
        die(f"{d} 已存在")
    d.mkdir(parents=True)
    meta = {"name": args.name, "exit": spec,
            "created_at": time.strftime("%Y-%m-%d %H:%M:%S")}
    write_meta(args.name, meta)
    profile = d / "profile"
    profile.mkdir()
    seed_of(profile)
    say(f"已建沙盒 {args.name}（出口 {spec}，目录 {d}）")
    say(f"下一步: sandbox open {args.name}")
    return 0


def run(args, headless: bool) -> int:
    cfg = load_config()
    meta = read_meta(args.name)
    spec = pick_exit(args, meta)
    spec, proxy = resolve_exit(pick_exit(args, meta), cfg)   # proxy 为空 = direct
    ip = preflight(args.name, spec, "", proxy)
    if ip.startswith("("):
        die("出口不通，先别继续")
    return launch(args.name, proxy, headless=headless, timeout=getattr(args, "timeout", 0))


def cmd_open(args) -> int:
    return run(args, headless=False)


def cmd_check(args) -> int:
    return run(args, headless=True)


def cmd_list(args) -> int:
    if not ROOT.is_dir():
        say("还没有沙盒")
        return 0
    say(f"{'名字':<16} {'出口':<24} {'出口 IP':<18} 创建时间")
    for d in sorted(ROOT.iterdir()):
        if not (d / "meta.json").is_file():
            continue
        m = json.loads((d / "meta.json").read_text(encoding="utf-8"))
        say(f"{m.get('name', d.name):<16} {m.get('exit', '-'):<24} "
            f"{m.get('exit_ip', '-'):<18} {m.get('created_at', '-')}")
    return 0


def cmd_doctor(args) -> int:
    cfg = load_config()
    say(f"沙盒目录  : {ROOT}")
    say(f"配置文件  : {CONFIG_FILE} {'有' if CONFIG_FILE.is_file() else '无（用内置默认）'}")
    say(f"venv      : {'有' if _VENV_PY.is_file() else '没有 .venv'}")
    say("")
    default = str(cfg.get("exit") or "direct")
    say(f"出口      : {default}" + ("（没配置 = direct）" if default == "direct" else ""))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="sandbox", description="Claude 注册沙盒（手工/自动两用）")
    sub = parser.add_subparsers(dest="cmd", required=True)

    def add_exit_flags(p):
        p.add_argument("--exit", help="出口名（配置里的）或 socks5h://host:port")
        p.add_argument("--proxy", help="同 --exit 的地址写法（优先）")

    p = sub.add_parser("new", help="建沙盒")
    p.add_argument("name")
    add_exit_flags(p)
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("open", help="开窗口，手工注册")
    p.add_argument("name")
    add_exit_flags(p)
    p.add_argument("--timeout", type=int, default=0, help="多少秒后自动关闭（0 = 一直开着）")
    p.set_defaults(func=cmd_open)

    p = sub.add_parser("check", help="无头自检：出口 IP / WebRTC（需要 xvfb）")
    p.add_argument("name")
    add_exit_flags(p)
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("list", help="列出沙盒")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("doctor", help="检查依赖和出口配置")
    p.set_defaults(func=cmd_doctor)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
