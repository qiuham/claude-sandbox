{
  "//": "复制到 ~/.config/claude-sandbox/config.json 后按实际环境改。出口支持 proxy（显式代理）和 direct（不用代理）两种形态。",
  "default_exit": "local",
  "exits": {
    "local": {
      "label": "本机 Clash / mihomo",
      "proxy": "socks5h://127.0.0.1:7897"
    },
    "my-residential": {
      "label": "任意住宅代理（直接给地址）",
      "proxy": "socks5h://user:pass@1.2.3.4:1080"
    },
    "direct": {
      "label": "原生环境（无代理）",
      "direct": true
    },
    "cox-46.2": {
      "label": "在 46.2 上跑时连 mihomo",
      "proxy": "socks5h://172.18.0.1:7871"
    }
  }
}
